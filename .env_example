# ── Database (local Docker or hosted PostgreSQL) ─────────────────────────────
POSTGRES_USER=kita
POSTGRES_PASSWORD=kita
POSTGRES_DB=kita
DATABASE_URL=postgresql://kita:kita@localhost:5432/kita

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Clerk authentication ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ── Cloudinary (optional — photo uploads, chat attachments) ───────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

# ── SMTP (optional — parent ↔ kindergarten messaging) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
