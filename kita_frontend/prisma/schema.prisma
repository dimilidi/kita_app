generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String             @id
  username    String             @unique
  name        String
  surname     String
  email       String?            @unique
  phone       String?            @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime           @default(now())
  parentId    String
  classId     Int
  gradeId     Int
  birthday    DateTime
  attendances Attendance[]
  results     Result[]
  class       Class              @relation(fields: [classId], references: [id])
  grade       Grade              @relation(fields: [gradeId], references: [id])
  parent      Parent             @relation(fields: [parentId], references: [id])
  lunchGroup  StudentLunchGroup?
  lunchVote   StudentLunchVote?
  studentZone StudentZone?
  zoneHistory ZoneHistory[]
}

model Teacher {
  id        String        @id
  username  String        @unique
  name      String
  surname   String
  email     String?       @unique
  phone     String?       @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime      @default(now())
  birthday  DateTime
  classes   Class[]
  lessons   Lesson[]
  zones     TeacherZone[]
  subjects  Subject[]     @relation("SubjectToTeacher")
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Grade {
  id       Int       @id @default(autoincrement())
  level    Int       @unique
  classess Class[]
  students Student[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  capacity      Int
  supervisorId  String?
  gradeId       Int
  announcements Announcement[]
  grade         Grade          @relation(fields: [gradeId], references: [id])
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  events        Event[]
  lessons       Lesson[]
  students      Student[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  teachers Teacher[] @relation("SubjectToTeacher")
}

model Lesson {
  id          Int          @id @default(autoincrement())
  name        String
  day         Day
  startTime   DateTime
  endTime     DateTime
  zoneId      String
  classId     Int
  teacherId   String
  assignments Assignment[]
  attendances Attendance[]
  exams       Exam[]
  class       Class        @relation(fields: [classId], references: [id])
  zone        Zone         @relation(fields: [zoneId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  assignmentId Int?
  studentId    String
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  exam         Exam?       @relation(fields: [examId], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  studentId String
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Zone {
  id          String        @id @default(cuid())
  name        String        @unique
  capacity    Int?
  description String?
  color       String?
  lessons     Lesson[]
  activities  Activity[]
  students    StudentZone[]
  teachers    TeacherZone[]
  history     ZoneHistory[]
}

model StudentZone {
  studentId String   @id
  zoneId    String
  movedAt   DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  zone      Zone     @relation(fields: [zoneId], references: [id])
}

model StudentLunchGroup {
  studentId  String            @id
  group      LunchGroup?
  movedAt    DateTime          @default(now())
  groupId    String?
  lunchGroup LunchGroupEntity? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id])
}

model Tischspruch {
  id        Int                @id @default(autoincrement())
  title     String             @unique
  createdAt DateTime           @default(now())
  text      String             @default("")
  votes     StudentLunchVote[]
}

model StudentLunchVote {
  studentId     String            @id
  tischspruchId Int
  group         LunchGroup?
  updatedAt     DateTime          @updatedAt
  groupId       String?
  lunchGroup    LunchGroupEntity? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student       Student           @relation(fields: [studentId], references: [id])
  tischspruch   Tischspruch       @relation(fields: [tischspruchId], references: [id], onDelete: Cascade)
}

model LunchGroupEntity {
  id          String              @id @default(cuid())
  name        String              @unique
  color       String?
  capacity    Int?                @default(15)
  createdAt   DateTime            @default(now())
  assignments StudentLunchGroup[]
  votes       StudentLunchVote[]
}

model TeacherZone {
  id        String  @id
  teacherId String
  zoneId    String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  zone      Zone    @relation(fields: [zoneId], references: [id])

  @@unique([teacherId, zoneId])
}

model ZoneHistory {
  id        String   @id
  studentId String
  movedAt   DateTime @default(now())
  zoneId    String
  student   Student  @relation(fields: [studentId], references: [id])
  zone      Zone     @relation(fields: [zoneId], references: [id])
}

model Activity {
  id     Int    @id @default(autoincrement())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])
}

enum LunchGroup {
  green
  yellow
  red
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
